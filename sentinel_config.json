      "https://cybersecuritynews.com/feed/",
      "https://feeds.feedburner.com/TheHackersNews"
    ]
  },
  "telegram": {
    "enabled": true,
    "parse_mode": "HTML"
  },
  "deduplication": {
    "enabled": true,
    "max_remembered": 500
  },
  "stats": {
    "enabled": true
  },
  "version": "1.4.1",
  "asset_criticality": {
    "production": {
      "weight": 3.0,
      "keywords": [
        "production",
        "prod",
        "live",
        "customer"
      ]
    },
    "staging": {
      "weight": 1.5,
      "keywords": [
        "staging",
        "dev",
        "test"
      ]
    },
    "internal": {
      "weight": 1.0,
      "keywords": [
        "internal",
        "admin",
        "dashboard"
      ]
    }
  },
  "webhook_url": "",
  "webhook_platform": "slack",
  "cloud": {
    "enabled": true,
    "providers": [
      "aws",
      "gcp",
      "azure"
    ],
    "detect_cloud_credentials": true,
    "detect_ssrf_to_metadata": true,
    "detect_container_escape": true
  },
  "notification_channels": [
    "telegram"
  ],
  "imessage": {
    "enabled": false,
    "provider": "sendblue",
    "to_number": "",
    "from_number": "",
    "env_vars": [
      "SENDBLUE_API_KEY",
      "SENDBLUE_API_SECRET"
    ],
    "note": "Requires Sendblue account (paid). See sendblue.com"
  }
}