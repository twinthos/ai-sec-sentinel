    "gcp",
    "azure",
    "cloud",
    "kubernetes",
    "docker",
    "terraform",
    "iam",
    "ssrf",
    "metadata"
  ],
  "monitored_accounts": [
    {
      "handle": "@theinjection_dev",
      "platform": "web",
      "topics": [
        "ai-security-weekly",
        "cve-tracker"
      ],
      "rss": [
        "https://theinjection.dev/week/feed/"
      ]
    },
    {
      "handle": "@NCSC",
      "platform": "x",
      "topics": [
        "uk-government",
        "ai-guidance",
        "agentic-ai"
      ],
      "rss": [
        "https://www.ncsc.gov.uk/blog/rss"
      ]
    },
    {
      "handle": "@BleepingComputer",
      "platform": "x",
      "topics": [
        "security-news",
        "breaches",
        "vulnerabilities"
      ],
      "rss": [
        "https://www.bleepingcomputer.com/feed/"
      ]
    },
    {
      "handle": "@KrebsOnSecurity",
      "platform": "x",
      "topics": [
        "investigative-security",
        "breaches",
        "threat-actors"
      ],
      "rss": [
        "https://krebsonsecurity.com/feed/"
      ]
    }
  ],
  "suppliers": [],
  "news": {
    "enabled": true,
    "keywords": [
