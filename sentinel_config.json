{
  "scan_interval_minutes": 60,
  "alert_min_severity": 1,
  "alert_on_medium": false,
  "auto_remediate": false,
  "allow_lockfile_upload": false,
  "feedback_enabled": true,
  "learn_from_actions": true,
  "sources": {
    "cve_now": true,
    "cisa_kev": true,
    "epss": true
  },
  "keywords": [
    "langchain",
    "llamaindex",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "mcp",
    "model context protocol",
    "agent",
    "agents",
    "copilot",
    "cursor",
    "codex",
    "claude code",
    "aider",
    "continue",
    "prompt injection",
    "rag",
    "retrieval augmented",
    "embedding",
    "vllm",
    "ollama",
    "litellm",
    "transformers",
    "huggingface",
    "autogen",
    "crewai",
    "semantic kernel",
    "langgraph",
    "ai agent",
    "coding agent",
    "llm framework",
